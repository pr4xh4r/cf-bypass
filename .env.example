# ─────────────────────────────────────────────
#  cf-bypass  ·  Environment Configuration
# ─────────────────────────────────────────────

# Target URL to bypass Cloudflare on
TARGET_URL=https://example.com/

# (Optional) Path to your Chrome/Chromium binary.
# Leave blank to use the auto-downloaded one.
CHROME_PATH=

# Timeout in seconds to wait for CF bypass (default: 120)
CF_TIMEOUT=120
